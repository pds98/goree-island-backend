# Copier en .env puis adapter. NE JAMAIS committer le vrai .env.

# Base de données (docker-compose la surcharge pour le conteneur api)
DATABASE_URL=postgresql+psycopg://goree:goree@localhost:5432/goree

# Clé d'administration (MVP) — à remplacer par OAuth2/JWT en production
CLE_ADMIN=change-moi

# Sel secret pour hacher les numéros de CNI (HMAC-SHA256)
SEL_CNI=change-moi-avec-une-longue-valeur-aleatoire

# Clé privée Ed25519 de signature des QR (PEM). Vide en dev : générée dans DOSSIER_CLES.
# Génération : python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K;from cryptography.hazmat.primitives import serialization as s;print(K.generate().private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption()).decode())"
CLE_PRIVEE_JETONS_PEM=

# Clé Fernet de chiffrement des photos de contrôle. Vide en dev : générée.
# Génération : python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CLE_CHIFFREMENT_PHOTOS=

# Paiement : true = confirmé immédiatement (démo). false = attente du webhook.
PAIEMENT_SIMULE=true
SECRET_WEBHOOK_PAIEMENT=change-moi

# Charge les circuits de démonstration au démarrage
SEED_DEMO=true

# Mode démo identité : numéro de CNI saisi à la main, photos réelles. JAMAIS en production.
IDENTITE_DEMO=true
